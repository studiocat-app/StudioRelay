{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ErrorBody",
  "description": "Error body returned by any device endpoint with a non-2xx status.",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "retryAfterMs": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "supported": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      }
    }
  },
  "required": [
    "code"
  ],
  "$defs": {
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "protocol_unsupported",
            "rate_limited",
            "bad_request"
          ]
        },
        {
          "description": "The device credential is missing or wrong.",
          "type": "string",
          "const": "unauthorized"
        },
        {
          "description": "The registration proof was rejected.",
          "type": "string",
          "const": "bad_proof"
        },
        {
          "description": "The license does not include the hosted relay, or has expired.",
          "type": "string",
          "const": "not_entitled"
        },
        {
          "description": "The license or device was revoked.",
          "type": "string",
          "const": "revoked"
        },
        {
          "description": "The request carried an old epoch; call `hello` again.",
          "type": "string",
          "const": "epoch_expired"
        }
      ]
    }
  }
}
